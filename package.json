{
  "name": "packetloss",
  "version": "0.0.0",
  "description": "A network-themed maze arcade game for the browser.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Haki-Malai/PACKETLOSS.git"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_GAME_ENV=DEMO vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "map:demo:convert": "node scripts/convert-demo-map.mjs",
    "test:all": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-vitest": "^0.5.4",
    "jsdom": "26.1.0",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^4.5.3",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.0"
  }
}

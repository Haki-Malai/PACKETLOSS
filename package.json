{
  "name": "packetloss",
  "version": "0.0.0",
  "description": "A network-themed maze arcade game for the browser.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Haki-Malai/PACKETLOSS.git"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "node scripts/dev-full.mjs",
    "dev:demo": "VITE_GAME_ENV=DEMO vite",
    "build": "vite build",
    "build:server": "node server/build.mjs",
    "build:backend": "node backend/build.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json && tsc -p tsconfig.simulation.json",
    "typecheck:backend": "tsc -p backend/tsconfig.json",
    "typecheck:dev": "tsc -p dev/tsconfig.json",
    "assets:portraits": "node scripts/render-enemy-portraits.js",
    "preview": "vite preview",
    "test": "vitest run",
    "map:demo:convert": "node scripts/convert-demo-map.mjs",
    "test:all": "pnpm run typecheck && pnpm run typecheck:server && pnpm run typecheck:backend && pnpm run typecheck:dev && pnpm run lint && pnpm run test && pnpm run build && pnpm run build:server && pnpm run build:backend",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-vitest": "^0.5.4",
    "jsdom": "26.1.0",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^4.5.3",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1146.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-ec2": "^3.1146.0",
    "@aws-sdk/client-ssm": "^3.1146.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  }
}
